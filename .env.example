VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Site key do Cloudflare Turnstile (captcha "confirme que você é humano"
# na tela de login) -- É PÚBLICA de propósito, pode ficar com o prefixo
# VITE_ e aparecer no navegador, é assim que o Turnstile funciona. A
# secret key (essa sim sensível) NUNCA entra neste projeto -- ela vai
# direto no painel do Supabase (Authentication > Attack Protection >
# Enable Captcha protection > Turnstile by Cloudflare), que é quem
# valida o token no servidor. Deixar essa variável vazia mantém o login
# funcionando normal, sem pedir captcha nenhum.
VITE_TURNSTILE_SITE_KEY=

# --- Fase 4 (Contrato Inteligente) -- só usadas pela função de servidor
# em api/ocr/extract.js, NUNCA pelo navegador. Sem prefixo VITE_ de
# propósito -- o Vite só inlina no bundle público variáveis com esse
# prefixo; estas precisam ficar de fora do JS que roda no navegador.
# Configurar só na Vercel (Project Settings > Environment Variables),
# nunca num .env commitado.

# Chave de serviço do Supabase (Project Settings > API > service_role) --
# ignora RLS, só usada no servidor pra baixar arquivo do Storage e
# verificar o token de quem chamou.
SUPABASE_SERVICE_ROLE_KEY=

# JSON da conta de serviço do Google Cloud (Document AI), em uma linha só.
GOOGLE_DOCUMENT_AI_CREDENTIALS=
GOOGLE_DOCUMENT_AI_PROJECT_ID=
GOOGLE_DOCUMENT_AI_LOCATION=
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=

# --- Ajuda e contato (Fale conosco) ---
# URL da página de ajuda DESTE app no site central (Dúvidas frequentes).
# Pública, por isso o prefixo VITE_. Vazia = o acesso fica escondido.
VITE_HELP_URL=

# Só no servidor (Vercel > Environment Variables), nunca no navegador:
# chave de API do Resend (resend.com) usada por api/support/contact.js.
RESEND_API_KEY=
# Opcionais: remetente e destino. Padrão: "NB Prime Rent <onboarding@resend.dev>"
# (remetente de teste do Resend, só entrega pro dono da conta Resend) e
# cleilogx@gmail.com.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
